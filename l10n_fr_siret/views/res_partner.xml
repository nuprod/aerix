<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add the SIREN and RC -->
    <record model="ir.ui.view" id="res_partner_form_l10n_fr">
        <field name="name">res.partner.form.siret</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_fr.view_partner_form_inherit_l10n_fr" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="parent_is_company" invisible="1" />
                <field
                    name="siren"
                    readonly="parent_id != False"
                    invisible="not is_company and not parent_is_company"
                />
                <field
                    name="nic"
                    invisible="not is_company and not parent_is_company"
                />
            </xpath>
            <xpath expr="//field[@name='child_ids']" position="attributes">
                <attribute name="context">{'default_nic': nic}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='child_ids']/form//field[@name='comment']"
                position="before"
            >
                <field name="nic" invisible="type in ('contact', 'private')" />
                <field
                    name="company_registry"
                    invisible="type in ('contact', 'private')"
                    readonly="1"
                />
            </xpath>
            <div name="warning_tax" position="after">
                <div
                    class="alert alert-warning"
                    role="alert"
                    name="warn_duplicate_siren"
                    invisible="not same_siren_partner_ids"
                > Duplicate warning: partner(s) <field
                        name="same_siren_partner_ids"
                        widget="x2many_buttons"
                    /> has/have the same <b>SIREN</b>. </div>
            </div>
        </field>
    </record>

    <record id="view_partner_tree" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="siren" optional="hide" readonly="1" />
                <field name="nic" optional="hide" readonly="1" />
                <field name="company_registry" optional="hide" readonly="1" />
            </field>
        </field>
    </record>
</odoo>