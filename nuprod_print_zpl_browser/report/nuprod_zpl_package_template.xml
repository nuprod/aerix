<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="nuprod_package_template_zpl">
            <t t-foreach="docs" t-as="package">
                <t t-translation="off">
                <t t-set="packageName" t-value="package.name"/>
                <t t-set="package_words" t-value="packageName.split(' ')"/>
                <t t-set="lineHeight" t-value="50"/>
                <t t-set="quantity_position" t-value="150"/>
                <t t-set="split_name_index" t-value="-1"/>

                ^XA^CI28
                <t t-if="package.quant_ids">
                    <t t-foreach="package.quant_ids" t-as="quant" t-key="quant_id">
                        ^FO150,<t t-out="lineHeight"/>
                        ^A0N,44,33^FDProduit: <t t-out="quant.product_id.display_name"/>^FS
                        <t t-set="lineHeight" t-value="lineHeight + 50"/>
                    </t>
                </t>
                <t t-if="'rebut' in packageName.lower()">
                    <t t-set="split_name_index" t-value="-2"/>
                </t>
                <t t-if="len(package_words) > 1 and len(packageName) > 30">
                    ^FO150,<t t-out="lineHeight" />
                    ^A0N,44,33^FDPal: <t t-out="' '.join(package_words[:split_name_index])" />
                    ^FS <t t-set="lineHeight" t-value="lineHeight + 50" />
                    ^FO150,<t t-out="lineHeight" />
                    ^A0N,44,33^FD<t t-out="' '.join(package_words[split_name_index:])" />
                    ^FS
                </t>
                <t t-else="">
                    ^FO150,<t t-out="lineHeight" />
                    ^A0N,44,33^FDPal:<t t-esc="packageName" />
                    ^FS
                </t>
                <t t-set="lineHeight" t-value="lineHeight + 50"/>
                ^FO150,<t t-out="lineHeight"/>
                <t t-if="package.pack_date">
                    ^A0N,44,33^FDDate: <t t-out="package.pack_date" t-options='{"widget": "date"}'/>
                    ^FS
                    <t t-set="quantity_position" t-value="400"/>
                </t>
                <t t-if="package.quant_ids">
                    <t t-foreach="package.quant_ids" t-as="quant" t-key="quant_id">
                        ^FO<t t-out="quantity_position"/>,<t t-out="lineHeight"/>
                        ^A0N,44,33^FDQuantite: <t t-out="quant.quantity"/> <t t-out="quant.product_uom_id.name"/>^FS
                    </t>
                </t>
                <t t-if="package.pack_date or package.quant_ids">
                    <t t-set="lineHeight" t-value="lineHeight + 50"/>
                </t>
                ^FO15,50 ^BQN,2,4 ^FDMA,<t t-out="package.name"/>^FS
                ^XZ
                </t>
            </t>
        </template>
    </data>
</odoo>
