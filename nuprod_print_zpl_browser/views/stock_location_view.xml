<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="nuprod_print_zpl_view_location_tree" model="ir.ui.view">
            <field name="name">nuprod.print.zpl.view.location.tree</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_tree2"/>
            <field name="arch" type="xml">
                <xpath expr="//list/field[1]" position="before">
                    <header>
                        <button string="Impression ZPL" class="oe_highlight" type="object" name="action_nuprod_print_location_zpl" />
                    </header>
                </xpath>
            </field>
        </record>

        <record id="nuprod_print_zpl_view_location_form" model="ir.ui.view">
            <field name="name">nuprod.print.zpl.view.location.form</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <button string="Impression ZPL" class="oe_highlight" type="object" name="action_nuprod_print_location_zpl" />
                </xpath>
            </field>
        </record>

    </data>
</odoo>
