<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="res_partner_form_l10n_fr_siret_lookup">
        <field name="name">res.partner.form.siret.lookup</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_fr.view_partner_form_inherit_l10n_fr" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field
                    name="ape"
                    invisible="not is_company and not parent_is_company"
                />
                <field
                    name="ape_label"
                    invisible="not is_company and not parent_is_company"
                />
            </xpath>
        </field>
    </record>

    <record id="fr_siret_lookup_partner_action" model="ir.actions.act_window">
        <field name="name">SIREN Lookup</field>
        <field name="res_model">fr.siret.lookup</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- <field name="groups_id" eval="[(4, ref('base.group_partner_manager'))]" /> -->
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="binding_view_types">form</field>
    </record>

</odoo>