<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="nuprod_config_printer_list" model="ir.ui.view">
    <field name="name">nuprod.config.printer.list</field>
    <field name="model">nuprod.config.printer</field>
    <field name="arch" type="xml">
      <list string="Paramètres">
        <field name="name" />
        <field name="ip_address" />
        <field name="port" />
        <field name="location_id" />
        <field name="description" />
        <field name="label_type" />
        <field name="is_active" widget="boolean_toggle" />
      </list>
    </field>
  </record>

  <record id="nuprod_config_printer_form" model="ir.ui.view">
    <field name="name">nuprod.config.printer.form</field>
    <field name="model">nuprod.config.printer</field>
    <field name="arch" type="xml">
      <form string="Propriétés">
        <sheet>
          <!-- Titre -->
          <div class="oe_title">
            <h1>
              <field name="name" />
            </h1>
          </div>

          <!-- Informations principales -->
         <group string="Connexion">
            <field name="network_type" string="Type de connexion"/>
            <group invisible="network_type != 'ip'">
                <field name="ip_address" required="network_type == 'ip'" />
                <field name="port" required="network_type == 'ip'"/>
            </group>
          </group>

          <!-- Descriptions -->
          <group string="Description">
            <group>
              <field name="location_id" />
              <field name="description" />
            </group>
            <group>
              <field name="label_type" />
              <field name="label_height" invisible="label_type != 'tspl'"
                require="label_type == 'tspl'" />
              <field name="label_width" invisible="label_type != 'tspl'"
                require="label_type == 'tspl'" />
                <field name="cn23_printer" invisible="label_type != 'pdf'" />
            </group>
          </group>

          <group string="Fonctionnement">
            <field name="is_active" />
          </group>

        </sheet>
      </form>
    </field>
  </record>


</odoo>