<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nu_project_project_form_inherit" model="ir.ui.view">
        <field name="name">project.project.view.form.simplified.inherit.aerix</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='alias_def']" position="before">
                <group>
                    <field name="nu_analytic_subplan_id"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
