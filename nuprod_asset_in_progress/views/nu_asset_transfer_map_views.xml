<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nu_asset_transfer_map_tree_view" model="ir.ui.view">
        <field name="name">nu.asset.transfer.map.list</field>
        <field name="model">nu.asset.transfer.map</field>
        <field name="arch" type="xml">
            <list string="Mappings immobilisations en cours">
                <field name="nu_company_id" groups="base.group_multi_company"/>
                <field name="nu_in_progress_account_id"/>
                <field name="nu_target_account_id"/>
                <field name="nu_journal_id"/>
                <field name="nu_is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="nu_asset_transfer_map_form_view" model="ir.ui.view">
        <field name="name">nu.asset.transfer.map.form</field>
        <field name="model">nu.asset.transfer.map</field>
        <field name="arch" type="xml">
            <form string="Mapping immobilisation en cours">
                <sheet>
                    <widget name="web_ribbon" title="Inactif" bg_color="text-bg-danger"
                            invisible="nu_is_active"/>
                    <group>
                        <group>
                            <field name="nu_company_id" groups="base.group_multi_company"/>
                            <field name="nu_in_progress_account_id"/>
                            <field name="nu_target_account_id"/>
                        </group>
                        <group>
                            <field name="nu_journal_id"/>
                            <field name="nu_is_active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nu_asset_transfer_map_action" model="ir.actions.act_window">
        <field name="name">Immobilisations en cours</field>
        <field name="res_model">nu.asset.transfer.map</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">
                Configurez un mapping de virement
            </p>
            <p>
                Associez chaque compte d'immobilisation en cours (23x) au compte
                définitif (21x/205x) et au journal d'OD à utiliser lors de la
                mise en service.
            </p>
        </field>
    </record>

    <menuitem id="nu_asset_transfer_map_menu"
              name="Immobilisations en cours"
              parent="account.menu_finance_configuration"
              action="nu_asset_transfer_map_action"
              sequence="100"/>

</odoo>
